{
  // Static-assets Worker. There is no server code — the whole site is the
  // built `dist/` folder, so no `main` script is declared.
  //
  // Cloudflare runs `npm run build` (set in the project's build settings),
  // then serves what lands in dist/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stevesqueelkarn",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./dist",
    // Single page app: unknown paths fall back to index.html rather than 404.
    "not_found_handling": "single-page-application"
  },
  // Attaches the custom domain on deploy — Cloudflare creates the DNS record
  // and issues the certificate itself, since the zone is in the same account.
  "routes": [{ "pattern": "stevesqueelkarn.com", "custom_domain": true }]
}
