# Cloudflare Pages headers.
# Hashed build assets are immutable; records.json changes weekly and must not
# be served stale after the Action pushes a new one.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/records.json
  Cache-Control: public, max-age=0, must-revalidate

# Icons and manifest are stable but unhashed — cache a day, then revalidate,
# so a replacement icon isn't stuck at the edge for a year.
/*.png
  Cache-Control: public, max-age=86400, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate

# The high school cars never change.
/cars/*
  Cache-Control: public, max-age=604800, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
